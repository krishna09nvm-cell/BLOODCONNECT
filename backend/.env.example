# ==========================================================
# LifeDrop server settings - copy this file to ".env" and fill it in.
#   Windows:   copy .env.example .env
#   Mac/Linux: cp .env.example .env
# .env holds SECRETS. It is read only by the server and is listed in
# .gitignore: never upload it to GitHub or put it in frontend code.
# ==========================================================

# ---- Website address (used in e-mail buttons and reset links) ----
APP_URL=http://localhost:5000

# ---- E-mail provider: resend | sendgrid | smtp ----
EMAIL_PROVIDER=resend

# Sender shown in the inbox. With Resend, before you verify your own
# domain you may only use onboarding@resend.dev, and it can only send
# to the e-mail address of your Resend account (fine for testing).
EMAIL_FROM=LifeDrop <onboarding@resend.dev>

# Optional: support address shown in every e-mail (also used as Reply-To)
SUPPORT_EMAIL=

# Resend (https://resend.com -> API Keys -> Create API key, "Sending access")
RESEND_API_KEY=

# SendGrid (https://sendgrid.com -> Settings -> API Keys, "Mail Send" permission;
# also verify a Single Sender and use it as EMAIL_FROM)
SENDGRID_API_KEY=

# SMTP, e.g. Gmail with an App Password (also run: npm install nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Secret used to sign "unsubscribe" links (any long random text)
EMAIL_LINK_SECRET=

# ---- Other settings ----
ADMIN_KEY=change-this-admin-key
# true = show the password reset link on the page (local demos ONLY)
SHOW_RESET_LINK=false

# ---- AI Assistant (chatbot) ----
# https://console.anthropic.com -> API Keys -> Create Key. Keep it secret (server only).
ANTHROPIC_API_KEY=
# Optional: model for the chatbot (fast and low-cost default)
CHAT_MODEL=claude-haiku-5-5

# ---------- Road routes on the camp map (optional) ----------
# Road route + distance + time come from OSRM (OpenStreetMap data).
# Default: the free public demo server https://router.project-osrm.org
# (light use only, max 1 request per second). For heavy use, run your own
# OSRM server and put its address here.
# OSRM_URL=https://router.project-osrm.org

# ---------- Hosting / deployment ----------
# On a hosting service set these in its "Environment variables" page
# (not in a file). See DEPLOYMENT.md in the project folder.
# NODE_ENV=production
# Folder where records are saved. Point it at a persistent disk/volume,
# e.g. /data (Railway volume) or /var/data (Render disk). Default: backend/data
# DATA_DIR=/data
# Real visitor IP behind the host's proxy (default 1 when NODE_ENV=production)
# TRUST_PROXY=1
# First admin account, created at start-up if it does not exist yet
# (alternative to "npm run create-admin"). Min 10 characters.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Admin
# off = delete ONLY the fictional demo donors/requests/camps at start-up
# DEMO_DATA=off
